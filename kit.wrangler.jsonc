// Only for the SvelteKit adapter: it writes its worker to this `main`. Deploys use wrangler.jsonc,
// whose `main` (src/worker.ts) wraps that worker and adds the cron. Keep both in sync.
{
  "name": "soleva",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
}
