{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soleva",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_als"],
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "routes": [{ "pattern": "solevaapp.com", "custom_domain": true }],
  // 07:00 UTC: 8–9 h in Spain. Close reminders (src/worker.ts).
  "triggers": { "crons": ["0 7 * * *"] },
  "workers_dev": true,
  "preview_urls": true,
}
