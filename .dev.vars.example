# Copy to .dev.vars and fill in. Never commit the real file.
# DATABASE_URL: connection string of the Neon dev branch.
DATABASE_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# ALLOWED_EMAILS: comma-separated emails that may sign in (empty = nobody).
ALLOWED_EMAILS=
# WAITLIST_OPEN=1 shows the waiting list form. Off in production until the legal texts are reviewed.
WAITLIST_OPEN=
# MARKETSTACK_API_KEY: paid alternative for stocks and ETFs. Empty = off.
MARKETSTACK_API_KEY=
